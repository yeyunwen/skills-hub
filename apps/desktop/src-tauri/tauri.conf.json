{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skills Hub",
  "version": "0.5.0",
  "identifier": "dev.skills-hub.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Skills Hub",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        },
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 560
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGQURFMDc1NUJCRjNEQzUKUldURlBiOWJkZUN0cnlLWllBT0pGbnJ3SnkyWHF3TWRWcHdnVytwMVBsR0N2eXptNFhTMHhjZHUK",
      "endpoints": [
        "https://github.com/yeyunwen/skills-hub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
